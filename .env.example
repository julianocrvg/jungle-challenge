# Valores de desenvolvimento local (docker compose up -d). Copie para .env; o Bun o carrega sozinho.
# Gerado a partir de src/config.ts, src/main.ts e do logger: cada linha traz o default do código.

# --- HTTP ---
PORT=3000
# Identifica a instância nos logs e no header X-Instance-Id. Sem valor: host-pid.
# INSTANCE_ID=local-1
# debug inclui a linha de requisição de /health/* e /metrics.
LOG_LEVEL=info

# --- PostgreSQL (container na porta 5433 do host; ARCHITECTURE 1.5) ---
DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering
# Só os testes de integração usam este banco.
TEST_DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering_test
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=10000

# --- SQS (LocalStack; credenciais fictícias) ---
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# --- Publisher da outbox (ARCHITECTURE 6) ---
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_SEND_TIMEOUT_MS=5000
# Default e mínimo: max(3 x OUTBOX_SEND_TIMEOUT_MS, 15000).
# OUTBOX_IDLE_TX_TIMEOUT_MS=15000

# --- Consumidor de wager-transactions.fifo (ARCHITECTURE 7) ---
SQS_CONSUMER_ENABLED=true
SQS_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_CONSUMER_MAX_ATTEMPTS=5
SQS_CONSUMER_WAIT_SECONDS=20
# Precisa ser >= DB_LOCK_TIMEOUT_MS + 5 s.
SQS_CONSUMER_VISIBILITY_TIMEOUT_S=30
SQS_CONSUMER_CONCURRENCY=10
SQS_CONSUMER_BACKOFF_BASE_MS=1000
SQS_CONSUMER_BACKOFF_MAX_MS=60000

# --- Worker de PENDING_REFERENCE (ARCHITECTURE 8) ---
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_CONCURRENCY=4
PENDING_REFERENCE_TTL_MS=3600000
PENDING_REFERENCE_MAX_ATTEMPTS=30
PENDING_REFERENCE_BACKOFF_BASE_MS=1000
PENDING_REFERENCE_BACKOFF_MAX_MS=300000

# --- Ledger paginado (ARCHITECTURE 9.2) ---
LEDGER_DEFAULT_PAGE_SIZE=50
LEDGER_MAX_PAGE_SIZE=100
